# Copy to .env for local development:  cp .env.example .env
# .env is git-ignored. Replace every "change-me" value. Never commit real values.
# In deployed environments, set these as real environment variables instead.

# ---- Local PostgreSQL (used by docker-compose.yml) --------------------------
POSTGRES_USER=marketplace
POSTGRES_PASSWORD=change-me
POSTGRES_DB=marketplace
POSTGRES_PORT=5432

# ---- FastAPI ------------------------------------------------------------------
# Must match the POSTGRES_* values above when using the local container.
DATABASE_URL=postgresql+psycopg://marketplace:change-me@localhost:5432/marketplace

# Optional: database used by the tests. Defaults to DATABASE_URL with "_test"
# added to the database name; the tests create it if needed and refuse to run
# against a database whose name does not end in "_test".
# TEST_DATABASE_URL=postgresql+psycopg://marketplace:change-me@localhost:5432/marketplace_test

# Expected "aud" claim of Marketplace JWTs (your product domain in Producer Portal)
MARKETPLACE_AUDIENCE=your-product-domain.example
MARKETPLACE_PROVIDER_ID=your-provider-id
# React page the browser is sent to after sign-up, and its origin for CORS
FRONTEND_URL=http://localhost:5173/marketplace/signup
FRONTEND_ORIGIN=http://localhost:5173
# How long a verified sign-up stays usable, in seconds
SIGNUP_SESSION_TTL_SECONDS=900

# Only needed for the Procurement API (approval is disabled in this milestone)
# GOOGLE_APPLICATION_CREDENTIALS=./key.json

# ---- Auth0 (see README.md, "Authentication with Auth0") ---------------------
# Tenant domain without https://, e.g. your-tenant.eu.auth0.com
AUTH0_DOMAIN=your-tenant.region.auth0.com
# Identifier of the Auth0 API for this service; must equal the frontend's VITE_AUTH0_AUDIENCE
AUTH0_AUDIENCE=https://api.your-product-domain.example
# Prefix of the custom claims added by the Auth0 Action; must match the Action exactly
AUTH0_CLAIM_NAMESPACE=https://marketplace.netpoleon.com/
